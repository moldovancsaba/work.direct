                  type="text"
                  value={currentTexts.yourGoalsLabel || ''}
                  onChange={(e) => updateTexts('yourGoalsLabel', e.target.value)}
                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="Your Goals"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Opponent Goals Label <span className="text-xs text-gray-500">(Score stats)</span></label>
