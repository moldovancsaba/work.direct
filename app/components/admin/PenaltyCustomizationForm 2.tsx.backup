                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Share Result Title</label>
                <input
                  type="text"
                  value={currentTexts.shareResultTitle || ''}
                  onChange={(e) => updateTexts('shareResultTitle', e.target.value)}
