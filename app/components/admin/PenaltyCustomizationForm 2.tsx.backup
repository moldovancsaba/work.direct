                  className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  placeholder="Game Not Found"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-1">Game Not Found Message <span className="text-xs text-gray-500">(Error description)</span></label>
                <input
                  type="text"
