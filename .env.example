# Environment variables read by the code (src/app.js; api/index.js passes process.env).
# Set them in Vercel -> Project settings -> Environment Variables (Production). Never commit real values.
# Setup order and the OAuth flow: see README.md ("Configure").

# --- Connector access -------------------------------------------------------
# Required. Random string used as the URL prefix of every private endpoint (/<secret>/mcp, /health,
# /oauth/*); it is the only credential the claude.ai custom connector carries. Without it the server
# answers 500. Generate with: openssl rand -hex 24
MCP_PATH_SECRET=

# --- Google OAuth client (Cloud console, "Web application" type) -------------
# Required for /oauth/start, /oauth/callback and every Google Tasks call.
GOOGLE_CLIENT_ID=
# Required, same as above.
GOOGLE_CLIENT_SECRET=

# --- Google authorization ----------------------------------------------------
# Required for every tool call and /health; not needed until the one-time authorization is done.
# Obtained once by opening /<MCP_PATH_SECRET>/oauth/start and copying the token shown on the callback page.
GOOGLE_REFRESH_TOKEN=
